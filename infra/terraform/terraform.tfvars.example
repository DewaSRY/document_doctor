# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored - never commit real secrets.
# Every variable has a working default; these are the ones worth reviewing.

docker_image = "sdewa/ai-translation:latest"
api_domain  = "api.example.com"
acme_email  = "ops@example.com"

# Set to a random value of at least 32 characters. Also set this exact value
# as the Cloudflare Worker secret AI_TRANSLATION_API_TOKEN.
# portal_api_token = "generate-a-random-value-of-at-least-32-characters"

# Optional for public models; avoids Hugging Face download rate limits.
# hf_token = "hf_..."

# nllb_model_name = "facebook/nllb-200-distilled-600M"
# Production apply is intentionally blocked until the selected model's
# license and model card permit commercial document-translation use.
# model_license_allows_production = true

# 16 GB RAM is the comfortable minimum for the model on CPU.
# instance_type    = "t3.xlarge"
# root_volume_size = 60

# SSH is closed by default; restrict it to your own public IP.
ssh_cidr_blocks = ["203.0.113.10/32"]

# Only needed if a browser calls the service directly; the portal calls it
# server-side.
# cors_origins = "https://your-portal.example.com"

# Leave db_host empty to run postgres on the instance (password generated
# by Terraform). To use an external database instead:
# db_host     = "your-db-host"
# db_port     = 5432
# db_user     = "ai_translation"
# db_name     = "ai_translation"
# db_password = "alphanumeric-password"

# Point api_domain at the EC2 Elastic IP with Cloudflare proxying disabled
# (DNS only). Caddy then obtains a trusted certificate automatically.
