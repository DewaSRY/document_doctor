# Copy this file to .env and fill in the values.

# Hugging Face Hub read token, avoids rate limits on model downloads.
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=
# REST API host to bind to.
REST_HOST=0.0.0.0
# Port the REST API server listens on.
REST_PORT=8000
PORTAL_API_TOKEN=
# Hugging Face model id to load, or leave unset to use the code default.
NLLB_MODEL_NAME=facebook/nllb-200-distilled-600M
# Local/mounted path to a self-trained checkpoint. Takes priority over MODEL_NAME.
# Point this at a persistent volume (see docs/MODEL_STORAGE.md) to skip re-downloads.
MODEL_PATH=

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ai_translation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_translation
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=0
DB_ECHO=false
DB_ECHO_POOL=false

# Development Configuration
DEV_MODE=true
DEBUG=false
RATE_LIMIT=100/minute

# CORS Configuration (comma-separated values)
# For DEV_MODE=false, add your production domains here
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://localhost
# Allowed headers for CORS requests
CORS_ALLOW_HEADERS=Origin,Content-Type,Authorization,X-Timezone,X-Request-Id
